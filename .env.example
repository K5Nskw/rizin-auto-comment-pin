# =============================================================================
# rizin-auto-comment-pin - environment variables
# Railway では Variables タブに同じキーを登録してください。
# =============================================================================

# --- 基本 -------------------------------------------------------------------
# Railway が自動で入れてくれるので通常は設定不要
PORT=3000

# 公開URL。Railway の Settings -> Networking で発行したドメインを入れる。
# OAuth のリダイレクト先と YouTube の push 通知先に使うので必須。
# 例: https://rizin-auto-comment-pin-production.up.railway.app
PUBLIC_URL=

# Railway で Postgres を追加すると自動的に注入される
DATABASE_URL=

# 管理画面のログイン情報（必ず変更する）
ADMIN_USER=admin
ADMIN_PASSWORD=

# トークン/Cookie の暗号化キー。32バイトの hex (64文字)。
# 生成: openssl rand -hex 32
ENCRYPTION_KEY=

# --- YouTube (Google Cloud Console で作成した OAuth クライアント) -------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# 監視する自分のチャンネルID (UC...)。未設定なら連携したアカウントのIDを使う。
YOUTUBE_CHANNEL_ID=

# YouTube の push 通知(WebSub)の署名検証用。ランダム文字列。
# 生成: openssl rand -hex 16
WEBSUB_SECRET=

# --- TikTok (developers.tiktok.com のアプリ) ---------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- AutoClipMaker 連携 -------------------------------------------------------
# 切り抜きが投稿されたことを AutoClipMaker から受け取るための共有トークン。
# AutoClipMaker 側の COMMENT_HOOK_TOKEN と同じ値にしてください。
# 未設定だと受け口は閉じたままになります。
# 生成: openssl rand -hex 32
#
# AutoClipMaker 側には以下を設定します:
#   COMMENT_HOOK_URL=https://<このアプリのURL>/ingest/clip
#   COMMENT_HOOK_TOKEN=<下と同じ値>
INGEST_TOKEN=

# --- プライバシーポリシー / 利用規約 -----------------------------------------
# このアプリは /privacy と /terms に規約ページを自動で公開します。
# TikTok の審査や Google の OAuth 同意画面に、そのURLを提出できます。
# ページに表示される運営者名と連絡先を設定してください。
# 例: LEGAL_ORG_NAME=RIZIN FIGHTING FEDERATION
LEGAL_ORG_NAME=
LEGAL_CONTACT_EMAIL=

# --- 動作設定 ---------------------------------------------------------------
# ブラウザ自動操作(ピン留め / TikTokコメント)を使うか
ENABLE_BROWSER_AUTOMATION=true

# 新着チェックの間隔（分）。WebSub が動いていれば YouTube はほぼ即時。
POLL_INTERVAL_MINUTES=5

# 失敗時・手動対応が必要なときの通知先 (Discord / Slack の Incoming Webhook URL)
NOTIFY_WEBHOOK_URL=

# 起動後、これより古い動画には絶対にコメントしない（安全装置・時間）
MAX_VIDEO_AGE_HOURS=48

# true の間は検知とコメント文の生成だけ行い、実際の投稿はしない（テスト用）
DRY_RUN=false

TZ=Asia/Tokyo
